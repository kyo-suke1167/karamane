// ==========================================
// 設定回り
// ==========================================
generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 定義 (Enums)
// ==========================================
enum SongStatus {
  PRACTICING // 練習中
  LEARNED    // 持ち歌 (デフォルト)
  MASTERED   // 十八番
}

// ==========================================
// ユーザー (User)
// ==========================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  
  // 自分の音域（ノートナンバー）
  minNoteId     Int?      @map("min_note_id") 
  maxNoteId     Int?      @map("max_note_id")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // リレーション
  songs         Song[]
  setlists      Setlist[] // セットリストへのリンク
  singingRecords SingingRecord[]

  // Google等の外部アカウント紐付け用
  accounts      Account[]

  @@map("users")
}

// ==========================================
// 持ち歌 (Song)
// ==========================================
model Song {
  id            Int       @id @default(autoincrement())
  
  title         String
  artist        String
  memo          String?
  youtubeUrl    String?   @map("youtube_url")

  // 曲の音域
  minNoteId     Int?      @map("min_note_id")
  maxNoteId     Int?      @map("max_note_id")

  // ステータス・キー設定
  status        SongStatus @default(LEARNED)
  key           Int        @default(0) // 設定キー (±0, +2, -3 など)

  // 所有者情報
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // リレーション (セットリストの中身へのリンク)
  setlistEntries SetlistEntry[]

  singingRecords SingingRecord[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("songs")
}

// ==========================================
// セットリスト (箱)
// ==========================================
model Setlist {
  id            Int       @id @default(autoincrement())
  title         String    // セットリスト名 (例: "2026夏ライブ")
  description   String?   // 説明 (例: "盛り上げ用リスト")
  
  // 作成者
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // セットリストの中身 (曲と順番の情報)
  entries       SetlistEntry[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("setlists")
}

// ==========================================
// セットリストの中身 (曲 + 順番)
// ==========================================
model SetlistEntry {
  id            Int       @id @default(autoincrement())

  // どのセットリストか？
  setlistId     Int       @map("setlist_id")
  setlist       Setlist   @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  // どの曲か？
  songId        Int       @map("song_id")
  song          Song      @relation(fields: [songId], references: [id], onDelete: Cascade)

  // 何番目か？
  order         Int       

  createdAt     DateTime  @default(now()) @map("created_at")
  
  // 検索を速くするためのインデックス
  @@index([setlistId])
  @@map("setlist_entries")
}

// ==========================================
// カラオケ日記 (歌唱記録)
// ==========================================
model SingingRecord {
  id          Int       @id @default(autoincrement())
  
  // 誰が歌ったか
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // どの曲を歌ったか
  songId      Int       @map("song_id")
  song        Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  
  // 記録データ
  score       Float?    // 点数（90.5など）
  key         Int?      // キー設定
  memo        String?   // 感想・メモ
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("singing_records")
}

// ==========================================
//  外部アカウント連携用 (NextAuth)
// ==========================================
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同じプロバイダー（Googleなど）で同じアカウントIDの重複を防ぐ
  @@unique([provider, providerAccountId])
  @@map("accounts")
}