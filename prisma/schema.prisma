generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SongStatus {
  PRACTICING // 練習中
  LEARNED    // 持ち歌 (デフォルト)
  MASTERED   // 十八番
}

// ユーザー
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  
  // 自分の音域（ノートナンバー）
  minNoteId     Int?      @map("min_note_id") 
  maxNoteId     Int?      @map("max_note_id")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  songs         Song[]
  
  @@map("users")
}

// 持ち歌
model Song {
  id            Int       @id @default(autoincrement())
  
  title         String
  artist        String
  memo          String?
  youtubeUrl    String?   @map("youtube_url")

  // 曲の音域
  minNoteId     Int?      @map("min_note_id")
  maxNoteId     Int?      @map("max_note_id")

  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  status    SongStatus @default(LEARNED)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("songs")
}